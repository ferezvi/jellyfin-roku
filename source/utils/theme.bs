import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/config.bs"

' Saves the current theme to the global node for easy access throughout the application
sub SaveThemeToGlobal()
    themeName = get_setting("theme", "dark")

    m.global.addFields({
        theme: getThemeColors(themeName)
    })
end sub

function getThemeColors(themeName as string) as object
    if themeName = "dark"
        return getDarkTheme()
    end if
    return getLightTheme()
end function

function getLightTheme() as object
    return {
        TEXT_PRIMARY: ColorPalette.CHARCOAL,
        TEXT_SECONDARY: ColorPalette.MIDGREY,
        TEXT_TERTIARY: ColorPalette.WARMGREY,
        TEXT_MUTED: ColorPalette.LIGHTGREY,

        FOCUS_TEXT_PRIMARY: ColorPalette.WHITE,
        FOCUS_TEXT_SECONDARY: ColorPalette.NEARWHITE,

        VIEWBACKGROUND: ColorPalette.WHITE,
        ELEMENTBACKGROUND: ColorPalette.NEARWHITE,

        HIGHLIGHT: ColorPalette.TRIADBLUE,
        LIGHTHIGHLIGHT: ColorPalette.PALEGREY,

        ERROR: ColorPalette.ALERTRED,

        CONFIG_BUTTON_BACKGROUND: ColorPalette.LIGHTGREY,

        BUTTON_BACKGROUND: ColorPalette.TRIADBLUE,
        BUTTON_FOCUS_BACKGROUND: ColorPalette.BUTTON_FOCUS_BACKGROUND,

        BUTTON_TEXT: ColorPalette.WHITE,
        BUTTON_FOCUS_TEXT: ColorPalette.WHITE,

        PROGRESS: ColorPalette.TRIADBLUE,
        PROGRESS_BACKGROUND: ColorPalette.LIGHTGREY,

        OVERLAY: ColorPalette.WHITEHALO,

        DELETE_FOCUS: ColorPalette.ALERTRED,

        SCROLLBAR_THUMB: ColorPalette.MIDGREY,

        ICON_DEFAULT: ColorPalette.CHARCOAL,
        ICON_ACTIVE: ColorPalette.TRIADBLUE,

        OUTLINE_DEFAULT: ColorPalette.LIGHTGREY,

        CARD_WASH: ColorPalette.OFFWHITE,
        CARD_ITEM_BACKGROUND: ColorPalette.WHITE,
        CARD_FOCUS_BORDER: ColorPalette.TRIADBLUE,
        CARD_FOCUS_HALO: ColorPalette.WHITEHALO,

        ' Add these for BaseScene
        BACKGROUND_OVERLAY: "#F5F5F5FF",
        BACKGROUND_OPACITY: 1.0
    }
end function

function getDarkTheme() as object
    return {

        TEXT_PRIMARY: ColorPalette.WHITE,
        TEXT_SECONDARY: ColorPalette.PALEGREY,
        TEXT_TERTIARY: ColorPalette.WARMGREY,
        TEXT_MUTED: ColorPalette.MUTEDGREY,

        FOCUS_TEXT_PRIMARY: ColorPalette.BLACK,
        FOCUS_TEXT_SECONDARY: ColorPalette.CHARCOAL,

        VIEWBACKGROUND: ColorPalette.NEARBLACK,
        ELEMENTBACKGROUND: ColorPalette.RAISEDBLACK,

        HIGHLIGHT: ColorPalette.WHITE,
        LIGHTHIGHLIGHT: ColorPalette.NEARWHITE,

        ERROR: ColorPalette.ALERTRED,

        CONFIG_BUTTON_BACKGROUND: ColorPalette.DARKPANEL,

        BUTTON_BACKGROUND: ColorPalette.BUTTONDARK,
        BUTTON_FOCUS_BACKGROUND: ColorPalette.WHITE,

        BUTTON_TEXT: ColorPalette.WHITE,
        BUTTON_FOCUS_TEXT: ColorPalette.BLACK,

        PROGRESS: ColorPalette.WHITE,
        PROGRESS_BACKGROUND: ColorPalette.PROGRESSTRACK,

        OVERLAY: ColorPalette.BLACKB8,

        DELETE_FOCUS: ColorPalette.ALERTRED,

        SCROLLBAR_THUMB: ColorPalette.SCROLLGREY,

        ICON_DEFAULT: ColorPalette.WHITE,
        ICON_ACTIVE: ColorPalette.WHITE,

        OUTLINE_DEFAULT: ColorPalette.OUTLINEDEFAULT,

        CARD_WASH: ColorPalette.SMOKE,
        CARD_ITEM_BACKGROUND: ColorPalette.CARDBACKGROUND,
        CARD_FOCUS_BORDER: ColorPalette.CARDFOCUSYELLOW,
        CARD_FOCUS_HALO: ColorPalette.WHITEHALO,

        BACKGROUND_OVERLAY: ColorPalette.BACKGROUND_OVERLAY,
        BACKGROUND_OPACITY: 1.0
    }
end function

' Returns the color for a given setting name, falling back to the theme color if not set in user settings
function themeColor(settingName as string, themeKey as string) as string
    return chainLookupReturn(m.global.session, "user.settings." + settingName, m.global.theme[themeKey])
end function
