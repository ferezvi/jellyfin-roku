enum ColorPalette

    ' Theme text
    TEXT_PRIMARY = "#FFFFFFFF"
    TEXT_SECONDARY = "#777777FF"
    TEXT_TERTIARY = "#101010FF"

    ' Backgrounds
    VIEWBACKGROUND = "#000018FF"
    ELEMENTBACKGROUND = "#101420FF"

    ' Highlights
    HIGHLIGHT = "#FF6867FF"
    LIGHTHIGHLIGHT = "#FF9A99FF"

    ' Supporting colors
    TRIADBLUE = "#6867FFFF"
    TRIADGREEN = "#67FF68FF"
    LIGHTBLUE = "#C8FAFAFF"
    RED = "#FF0000FF"
    ERROR = "#CC0000FF"

    ' Grayscale
    WHITE = "#FFFFFFFF"
    OFFWHITE = "#CCCCCCFF"
    LIGHTGREY = "#AAAAAAFF"
    MIDGREY = "#777777FF"
    SMOKE = "#303030FF"
    DARKGREY = "#101010FF"

    ' Overlays
    BLACK77 = "#00000077"
    BLACK90 = "#00000090"
    BLACKDD = "#000000DD"
    TRANSPARENT = "#00000000"

    ' Buttons
    BUTTON_BACKGROUND = "#C8FAFAFF"
    BUTTON_TEXT = "#101010FF"
    BUTTON_FOCUS_BACKGROUND = "#FF6867FF"
    BUTTON_FOCUS_TEXT = "#FFFFFFFF"

end enum
