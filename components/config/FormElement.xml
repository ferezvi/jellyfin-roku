<?xml version="1.0" encoding="utf-8"?>
<component name="FormElement" extends="Group">
  <children>
    <Text id="label"
      horizAlign="left"
      vertAlign="top"
      font="font:SmallestSystemFont"
      height="28"
      width="600"
      translation="[0, 0]" />
    <Group translation="[0, 32]">
      <Poster
        id="buttonBackground"
        uri="pkg:/images/card.9.png"
        translation="[0, 0]"
        height="60"
        width="600" />
      <TextEditBox
        id="value"
        translation="[18, 0]"
        height="60"
        width="560"
        maxTextLength="120"
        backgroundUri="pkg:/images/transparent.png" />
      <Poster
        id="valueFocusOutline"
        uri="pkg:/images/card_focus.9.png"
        translation="[0, 0]"
        height="60"
        width="600"
        visible="false" />
    </Group>
  </children>

  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onItemHasFocusChange" />
  </interface>
</component>