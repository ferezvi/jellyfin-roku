<?xml version="1.0" encoding="utf-8"?>
<component name="JFServer" extends="Group">

  <interface>
    <field id="itemContent" type="node" onchange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onchange="onItemHasFocusChange" />
  </interface>

  <children>
    <Rectangle id="background" translation="[0,0]" width="1460" height="100" />
    <Poster id="serverCard" translation="[0,0]" width="1460" height="100" uri="pkg:/images/card.9.png" />
    <Poster id="focusIndicator" translation="[0,0]" width="1460" height="100" uri="pkg:/images/card_focus.9.png" visible="false" />
    <MaskGroup maskUri="pkg:/images/$$RES$$/smallMask.png" translation="[25,20]">
      <Poster id="poster" width="60" height="60" />
    </MaskGroup>
    <Group id="labels" translation="[120,0]">
      <Text text="Name:" horizAlign="left" font="font:MediumBoldSystemFont" width="130" height="65" translation="[0,5]" />
      <Text text="URL:" horizAlign="left" font="font:MediumBoldSystemFont" width="130" height="65" translation="[0,55]" />

      <Text id="name" horizAlign="left" font="font:MediumSystemFont" height="65" translation="[145,5]" />
      <Text id="baseUrl" horizAlign="left" font="font:MediumSystemFont" height="65" translation="[145,55]" />
    </Group>

    <Rectangle id="trashContainer" translation="[1480,0]" width="100" height="100">
      <Poster id="trashBackground" width="100" height="100" uri="pkg:/images/icons/circle.png" />
      <Poster id="trash" width="50" height="50" uri="pkg:/images/icons/trash.png" translation="[25,25]" />
      <Poster id="trashFocus" width="100" height="100" uri="pkg:/images/circle_focus.png" visible="true" />

    </Rectangle>
  </children>

</component>