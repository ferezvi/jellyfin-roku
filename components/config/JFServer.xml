<?xml version="1.0" encoding="utf-8"?>
<component name="JFServer" extends="Group">

  <interface>
    <field id="itemContent" type="node" onchange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onchange="onItemHasFocusChange" />
  </interface>

  <children>
    <Rectangle id="background" translation="[0,0]" width="1460" height="100" color="#00000000" />

    <Poster id="poster" translation="[20,20]" width="75" height="75" uri="pkg:/images/icons/jellyfin-logo.png" />
    <Group id="labels" translation="[110,0]">
      <Text id="name" horizAlign="left" font="font:MediumSystemFont" height="65" translation="[0,20]" />
      <Text id="baseUrl" horizAlign="left" font="font:MediumSystemFont" height="65" translation="[0,70]" />
    </Group>

    <Rectangle id="trashWrapper" translation="[1460,0]" width="100" height="100" color="#00000000">
      <Poster id="trash" translation="[32,37]" width="36" height="36" uri="pkg:/images/icons/trash.png" />
    </Rectangle>
  </children>

</component>