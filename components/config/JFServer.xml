<?xml version="1.0" encoding="utf-8"?>
<component name="JFServer" extends="Group">

  <interface>
    <field id="itemContent" type="node" onchange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onchange="onItemHasFocusChange" />
  </interface>

  <children>
    <!-- Fondo de la fila -->
    <Poster id="background" width="1560" height="100" uri="pkg:/images/ocelotl/card-bg.9.png" />

    <!-- Icono servidor -->
    <Poster id="serverIcon" translation="[18, 18]" width="64" height="64" uri="pkg:/images/ocelotl/icons/ui/server-icon.png" />
    <!-- Nombre y URL -->
    <Label id="name" translation="[100, 18]" font="font:MediumBoldSystemFont" />
    <Label id="baseUrl" translation="[100, 58]" font="font:SmallSystemFont" />

    <!-- Trash icon (solo servidores guardados) -->
    <Poster id="trash" translation="[1516, 25]" width="50" height="50" uri="pkg:/images/jellyfin-icons/trash.png" visible="false" />
  </children>

</component>