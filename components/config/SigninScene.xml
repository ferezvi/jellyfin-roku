<?xml version="1.0" encoding="utf-8"?>
<component name="SigninScene" extends="JFScreen">
  <children>
    <Poster id="appIcon" translation="[60,40]" width="64" height="64" uri="pkg:/images/ocelotl/icons/ui/jellyfin-logo.png" />
    <Label id="jf" translation="[136,58]" text="Jellyfin" font="font:MediumBoldSystemFont" />

    <Poster id="avatarCircle" translation="[880,160]" width="200" height="200" uri="pkg:/images/ocelotl/icons/ui/avatar-circle-sm.png" />
    <Poster id="overlayCurrentUserProfileImage" translation="[880,160]" width="200" height="200" loadDisplayMode="scaleToZoom" uri="pkg:/images/ocelotl/icons/ui/avatar-default-sm.png" />
    <LayoutGroup translation="[160,160]" layoutDirection="vert" itemSpacings="8">
      <Label id="prompt" text="Sign In" font="font:LargeBoldSystemFont" />
      <Label id="subtitle" text="Enter your credentials to continue." font="font:SmallestSystemFont" />
    </LayoutGroup>

    <Rectangle id="errorContainer" visible="false" width="600" height="60" translation="[660, 386]">
      <Text id="errorMessage" text="" wrap="true" width="600" font="font:MediumSystemFont" horizAlign="center" translation="[10, 15]" />
    </Rectangle>

    <Poster id="signInFormBg" width="870" height="280" translation="[525,466]" uri="pkg:/images/ocelotl/card-bg.9.png" />

    <Rectangle id="signInFormContainer" width="870" height="280" translation="[525,466]" color="0x00000000">
      <FormList id="configOptions" translation="[60,40]" itemSpacing="[0,50]" />
    </Rectangle>

    <CheckList
      id="saveCredentials"
      checkedState="[true]"
      translation="[560, 771]"
      focusFootprintBitmapUri=""
      drawFocusFeedback="false">
      <ContentNode role="content">
        <ContentNode title="Save Credentials?" />
      </ContentNode>
    </CheckList>

    <StandardButton
      id="submit"
      text="Submit"
      height="84"
      width="351"
      translation="[584,900]" />

    <StandardButton
      id="quickConnect"
      text="Quick Connect"
      height="84"
      width="351"
      translation="[985,900]" />

    <Timer id="quickConnectTimer" duration="3" repeat="true" />
  </children>
  <interface>
    <field id="user" type="string" onchange="onUserChange" value="" />
    <field id="profileImageUri" type="string" onchange="onProfileImageUriChange" value="" alwaysNotify="true" />
    <field id="alert" type="string" onchange="onAlertChange" value="" />
  </interface>
</component>