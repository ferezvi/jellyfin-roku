<?xml version="1.0" encoding="utf-8"?>
<component name="SetServerScreen" extends="JFScreen">
  <children>
    <LayoutGroup translation="[150,150]" itemSpacings="40">
      <LayoutGroup>
        <Text text="Connect to Server" id="prompt" font="font:LargeBoldSystemFont" />
      </LayoutGroup>

      <Rectangle id="serverPickerContainer" width="1460" height="400">
        <MarkupList
          id="serverPicker"
          translation="[20, 20]"
          drawFocusFeedback="false"
          itemComponentName="JFServer"
          focusFootprintBitmapUri=""
          itemSpacing="[0, 30]"
          itemSize="[1580, 100]"
          numRows="3"
          vertFocusAnimationStyle="fixedFocus" />
      </Rectangle>

      <Text id="manualEntryHint" text="...or enter server URL manually:" font="font:SmallSystemFont" translation="[0, 690]" />
      <Rectangle id="serverUrlContainer">
        <Poster id="serverUrlBackground" visible="true" uri="pkg:/images/card.9.png" width="1460" height="60" />
        <TextEditBox id="serverUrlTextbox" translation="[24, 0]" hintText="e.g. 192.168.1.100:8096 or https://example.com/jellyfin" backgroundUri="pkg:/transparent.png" />
        <Poster id="serverUrlOutline" visible="false" uri="pkg:/images/card_focus.9.png" width="1460" height="60" />
      </Rectangle>

      <Text id="errorMessage" text="" font="font:MediumSystemFont" />

      <LayoutGroup horizAlignment="center">
        <Group>
          <StandardButton
            id="submit"
            text="Submit"
            height="60"
            width="200" />
          <Poster id="submit_focus"
            translation="[0,0]"
            visible="false"
            uri="pkg:/images/pill_button_focus.png"
            width="200"
            height="60" />
        </Group>

        <!--add a known width invisibile element to allow the button to be centered-->
        <Rectangle id="submitSizer" width="1460" height="0" color="0x00000000" />
      </LayoutGroup>
    </LayoutGroup>
  </children>
  <interface>
    <field id="forgetServer" type="string" />
    <field id="serverUrl" type="string" alias="serverUrlTextbox.text" />
    <field id="serverWidth" alias="serverUrlOutline.width,serverUrlTextbox.width,serverUrlContainer.width,submitSizer.width" value="1460" />
    <field id="serverHeight" alias="serverUrlOutline.height,serverUrlTextbox.height,serverUrlContainer.height" value="60" />
    <field id="errorMessage" type="string" alias="errorMessage.text" />
  </interface>
</component>