<?xml version="1.0" encoding="utf-8"?>
<component name="SetServerScreen" extends="JFScreen">
  <children>

    <!-- Header -->
    <Poster id="appIcon" translation="[60,40]" width="64" height="64" uri="pkg:/images/ocelotl/icons/ui/jellyfin-logo.png" />
    <Label id="jf" translation="[136,58]" text="Jellyfin" font="font:MediumBoldSystemFont" />

    <!-- Main content -->
    <LayoutGroup id="content" translation="[160,160]" layoutDirection="vert" itemSpacings="18">

      <Label id="prompt" text="Connect to Server" font="font:LargeBoldSystemFont" />
      <Label id="subtitle" text="Enter the details of your Jellyfin server to get started." font="font:SmallestSystemFont" />

      <!-- Placeholder to reserve the server list height -->
      <Rectangle width="1" height="430" color="0x00000000" />

      <Label text="If no server is listed above, you may also enter the server URL manually:" font="font:SmallestSystemFont" />

      <Group id="serverUrlContainer">
        <Poster id="serverUrlBackground" width="1600" height="72" uri="pkg:/images/ocelotl/card-bg.9.png" />
        <Poster id="globeIcon" translation="[20,24]" width="24" height="24" uri="pkg:/images/ocelotl/icons/ui/icon-globe.png" />
        <TextEditBox id="serverUrlTextbox" translation="[56,36]" width="1520" backgroundUri="pkg:/images/ui/transparent.png" hintText="e.g. 192.168.1.100:8096 or https://example.com/jellyfin" />
      </Group>

      <Label id="errorMessage" text="" color="#ff0000FF" font="font:MediumSystemFont" />

    </LayoutGroup>

    <!-- Server list -->
    <Group id="serverSection" translation="[160,320]">
      <Poster id="serverPickerContainer" width="1600" height="380" uri="pkg:/images/ocelotl/card-bg.9.png" />
      <MarkupList id="serverPicker" translation="[20,20]" drawFocusFeedback="false" itemComponentName="JFServer" itemSize="[1560,100]" itemSpacing="[0,24]" numRows="3" vertFocusAnimationStyle="floatingFocus" />
    </Group>

    <!-- Button -->
    <StandardButton id="submit" translation="[785,920]" width="351" height="84" text="Connect" />
  </children>

  <interface>
    <field id="forgetServer" type="string" />
    <field id="serverUrl" type="string" alias="serverUrlTextbox.text" />
    <field id="errorMessage" type="string" alias="errorMessage.text" />
  </interface>
</component>