<?xml version="1.0" encoding="utf-8"?>
<component name="SetServerScreen" extends="JFScreen">
  <children>
    <LayoutGroup translation="[60,60]" layoutDirection="horizontal" vertAlignment="center" itemSpacings="20">
      <Poster id="appIcon" width="60" height="60" uri="pkg:/images/icons/jellyfin-logo.png" />
      <Label id="jf" text="Jellyfin" font="font:MediumBoldSystemFont" />
    </LayoutGroup>

    <LayoutGroup translation="[150,150]" itemSpacings="[20]">
      <LayoutGroup itemSpacings="16">
        <Text text="Connect to Server" id="prompt" font="font:LargeBoldSystemFont" />
        <Label id="subtitle" text="Enter the details of your Jellyfin server to get started." font="font:SmallestSystemFont" />
      </LayoutGroup>


      <RoundedBackground id="serverPickerContainer" width="1620" height="400" radius="12" />

      <Text text="...or enter server URL manually:" translation="[0, 690]" />

      <RoundedBackground id="serverUrlContainer" radius="8">
        <TextEditBox id="serverUrlTextbox" translation="[12, 0]" hintText="e.g. 192.168.1.100:8096 or https://example.com/jellyfin" backgroundUri="pkg:/images/ui/transparent.png" />
        <Poster id="serverUrlOutline" visible="false" />
      </RoundedBackground>

      <Text id="errorMessage" text="" font="font:MediumSystemFont" />

      <LayoutGroup horizAlignment="center">
        <StandardButton
          translation="[0, 20]"
          id="submit"
          text="Submit"
          height="75"
          width="300"
          radius="6" />

        <!--add a known width invisibile element to allow the button to be centered-->
        <Rectangle id="submitSizer" width="1620" height="0" />
      </LayoutGroup>
    </LayoutGroup>

    <MarkupList
      id="serverPicker"
      translation="[170,300]"
      drawFocusFeedback="true"
      itemComponentName="JFServer"
      itemSpacing="[0, 24]"
      itemSize="[1580, 120]"
      numRows="3"
      vertFocusAnimationStyle="floatingFocus" />

  </children>
  <interface>
    <field id="forgetServer" type="string" />
    <field id="serverUrl" type="string" alias="serverUrlTextbox.text" />
    <field id="serverWidth" alias="serverUrlOutline.width,serverUrlTextbox.width,serverUrlContainer.width,submitSizer.width" value="1620" />
    <field id="serverHeight" alias="serverUrlOutline.height,serverUrlTextbox.height,serverUrlContainer.height" value="60" />
    <field id="errorMessage" type="string" alias="errorMessage.text" />
  </interface>
</component>