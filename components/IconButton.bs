sub init()
    m.buttonBackground = m.top.findNode("buttonBackground")
    m.buttonIcon = m.top.findNode("buttonIcon")
    m.buttonText = m.top.findNode("buttonText")

    m.top.observeField("background", "onBackgroundChanged")
    m.top.observeField("icon", "onIconChanged")
    m.top.observeField("text", "onTextChanged")
    m.top.observeField("height", "onHeightChanged")
    m.top.observeField("width", "onWidthChanged")
    m.top.observeField("padding", "onPaddingChanged")
    m.top.observeField("focus", "onFocusChanged")
    m.top.observeField("iconColor", "onIconColorChanged")
    m.top.observeField("roundBackground", "onRoundBackgroundChanged")
end sub

sub onRoundBackgroundChanged()
    if m.top.roundBackground
        m.buttonBackground.uri = "pkg:/images/ui/focus-circle.png"
    else
        m.buttonBackground.uri = "pkg:/images/ui/white.9.png"
    end if
    updateBackgroundShape()
end sub

sub updateBackgroundShape()
    if m.top.roundBackground
        iconSize = m.top.height
        if m.top.padding > 0 then iconSize = iconSize - m.top.padding
        diameter = iconSize + 12 ' 6px de aire alrededor del ícono

        m.buttonBackground.width = diameter
        m.buttonBackground.height = diameter
        m.buttonBackground.translation = [(m.top.width - diameter) / 2, (m.top.height - diameter) / 2]
    else
        m.buttonBackground.width = m.top.width
        m.buttonBackground.height = m.top.height
        m.buttonBackground.translation = [0, 0]
    end if
end sub

sub onFocusChanged()
    if m.top.focus
        m.buttonBackground.blendColor = m.top.focusBackground
    else
        m.buttonBackground.blendColor = m.top.background
    end if
end sub

sub onBackgroundChanged()
    m.buttonBackground.blendColor = m.top.background
    m.top.unobserveField("background")
end sub

sub onIconChanged()
    m.buttonIcon.uri = m.top.icon
end sub

sub onTextChanged()
    m.buttonText.text = m.top.text
end sub

sub setIconSize()
    height = m.buttonBackground.height
    width = m.buttonBackground.width
    if height > 0 and width > 0
        ' TODO: Use smallest number between them
        m.buttonIcon.height = m.top.height

        if m.top.padding > 0
            m.buttonIcon.height = m.buttonIcon.height - m.top.padding
        end if

        m.buttonIcon.width = m.buttonIcon.height

        m.buttonIcon.translation = [((width - m.buttonIcon.width) / 2), ((height - m.buttonIcon.height) / 2)]
        m.buttonText.translation = [0, height + 10]
        m.buttonText.width = width
    end if
end sub

sub onHeightChanged()
    updateBackgroundShape()
    setIconSize()
end sub

sub onWidthChanged()
    updateBackgroundShape()
    setIconSize()
end sub

sub onPaddingChanged()
    setIconSize()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "right" and m.top.focus
        m.top.escape = "right"
    end if

    if key = "left" and m.top.focus
        m.top.escape = "left"
    end if

    if key = "up" and m.top.focus
        m.top.escape = "up"
    end if

    if key = "down" and m.top.focus
        m.top.escape = "down"
    end if

    return false
end function

sub onIconColorChanged()
    m.buttonIcon.blendColor = m.top.iconColor
end sub
