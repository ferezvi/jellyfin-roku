<?xml version="1.0" encoding="utf-8"?>
<component name="PlayedCheckmark" extends="Group">
  <children>
    <Poster
      id="badgeBackground"
      width="54"
      height="54"
      uri="pkg:/images/ocelotl/badges/badge_cap.png" />
    <Label
      id="checkmark"
      width="54"
      height="54"
      font="font:MediumBoldSystemFont"
      horizAlign="center"
      vertAlign="center"
      text="✓"
      visible="false" />
    <Label
      id="unplayedNumber"
      width="54"
      height="54"
      font="font:MediumBoldSystemFont"
      horizAlign="center"
      vertAlign="center"
      visible="false" />
  </children>
  <interface>
    <field id="data" type="assocarray" onChange="onDataChange" />
  </interface>
</component>