<?xml version="1.0" encoding="utf-8"?>
<component name="HomeItem" extends="Group">
  <children>
    <Poster id="backdrop" width="462" height="261" uri="pkg:/images/ocelotl/masks/$$RES$$/wide_poster_mask.png" loadDisplayMode="scaleToFit" />
    <Poster id="itemIcon" width="100" height="100" translation="[190,85]" loadDisplayMode="scaleToFit" />
    <MaskGroup id="itemPosterMask" maskUri="pkg:/images/ocelotl/masks/$$RES$$/wide_poster_mask.png">
      <Poster id="itemPoster" width="462" height="261" loadDisplayMode="scaleToZoom" />
    </MaskGroup>

    <PlayedCheckmark id="playedIndicator" translation="[375, 0]" />
    <Group id="progressBackground" visible="false" translation="[15,236]">
      <Poster id="progressTrack" width="432" height="6" loadDisplayMode="scaleToFit" uri="pkg:/images/ocelotl/progress/progress_track_bg.png" />

      <Rectangle id="progress" width="0" height="6" visible="false" />

      <Poster id="progressFill" translation="[3,0]" width="0" height="6" uri="pkg:/images/ocelotl/progress/progress_fill.png" />
      <Poster id="fillCapLeft" width="6" height="6" loadDisplayMode="scaleToFit" visible="false" uri="pkg:/images/ocelotl/progress/progress_cap.png" />
      <Poster id="fillCapRight" width="6" height="6" loadDisplayMode="scaleToFit" visible="false" uri="pkg:/images/ocelotl/progress/progress_cap.png" />
    </Group>

    <ScrollingText id="itemText" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" height="64" maxWidth="456" translation="[8,267]" repeatCount="0" />
    <Text id="itemTextExtra" horizAlign="left" vertAlign="center" font="font:SmallBoldSystemFont" height="32" width="456" translation="[8,300]" visible="false" />

    <Animation id="showProgressBar" duration="0.5" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="showProgressBarField" key="[0.0, 1.0]" fieldToInterp="progress.width" />
    </Animation>
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="focusChanged" />
  </interface>
</component>